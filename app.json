{
  "expo": {
    "name": "Yarkib",
    "slug": "yarkib",
    "owner": "shabbar.raza",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "yarkib",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yarkib.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "com.yarkib.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "yarkib",
              "host": "oauth",
              "pathPrefix": "/*"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsDownloadToken": "sk.eyJ1Ijoic3phaWQwMDEiLCJhIjoiY21na3o3MnI2MDJ0MDJscjU1MGRpaG40bSJ9.JBJ-H6HPUBGk6V0PDphYIg"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Yarkib to access your location.",
          "locationAlwaysPermission": "Allow Yarkib to always access your location.",
          "locationWhenInUsePermission": "Allow Yarkib to access your location while you are using the app."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c1a43a2b-19d5-4495-85c2-29748f23c2e6"
      }
    }
  }
}
