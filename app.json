{
  "expo": {
    "name": "Yarkib",
    "slug": "yarkib",
    "owner": "shabbar26",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "yarkib",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yarkib.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "com.yarkib.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "yarkib",
              "host": "oauth",
              "pathPrefix": "/*"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsDownloadToken": "sk.eyJ1Ijoic3phaWQwMDEiLCJhIjoiY21na3o3MnI2MDJ0MDJscjU1MGRpaG40bSJ9.JBJ-H6HPUBGk6V0PDphYIg"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ce61d81b-9561-45ac-909f-72477d8651e2"
      }
    }
  }
}
